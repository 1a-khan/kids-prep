# Optional direct override. Prefer OpenBao for local/dev secrets.
# NOTION_TOKEN=notion_token_placeholder

# OpenBao / Vault-compatible secret lookup for the Notion integration token.
# OPENBAO_* is preferred by the app. BAO_* and VAULT_* are also accepted.
OPENBAO_ADDR=http://127.0.0.1:8200
OPENBAO_TOKEN=your_openbao_token
OPENBAO_KV_MOUNT=secret
OPENBAO_APP_SECRET_PATH=coolify/kids-prep
OPENBAO_NOTION_SECRET_PATH=kids-prep/notion
OPENBAO_NOTION_TOKEN_FIELD=notion_token

# Optional local-only login fallback. Production should load these from OpenBao:
# secret/coolify/kids-prep/login/users
# KIDS_PREP_MIHRIMAH_PASSWORD=change-me-mihrimah
# KIDS_PREP_MUSTAFA_PASSWORD=change-me-mustafa
# KIDS_PREP_ADMIN_PASSWORD=change-me-admin

# Notion database/page IDs are loaded from OpenBao:
# secret/coolify/kids-prep/notion/config
