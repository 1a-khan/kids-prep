<main class="shell">
  <%= if Phoenix.Flash.get(@flash, :info) do %>
    <p class="flash info">{Phoenix.Flash.get(@flash, :info)}</p>
  <% end %>
  <%= if Phoenix.Flash.get(@flash, :error) do %>
    <p class="flash error">{Phoenix.Flash.get(@flash, :error)}</p>
  <% end %>
  {@inner_content}
</main>
