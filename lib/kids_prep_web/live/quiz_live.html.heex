<section class="topbar">
  <button class="brand" phx-click="home">
    <span class="mark">MM</span>
    <span>Gymnasium-Vorbereitung</span>
  </button>
  <div class="top-actions">
    <span class="user-pill">{@current_user["display_name"]}</span>
    <%= if @current_user["role"] == "admin" do %>
      <button class="notion-link" phx-click="dashboard">Leistung</button>
      <button class="notion-link" phx-click="refresh_cache">Fragen aktualisieren</button>
      <button class="notion-link" phx-click="sync_results">
        Ergebnisse synchronisieren
        <%= if @unsynced_result_count > 0 do %>
          ({@unsynced_result_count})
        <% end %>
      </button>
      <a class="notion-link" href={~p"/auth/notion"}>Notion verbinden</a>
    <% end %>
    <a class="notion-link" href={~p"/logout"}>Abmelden</a>
    <div class="date-pill">{Date.utc_today()}</div>
  </div>
</section>

<%= if @mode == :home do %>
  <section class="intro">
    <div>
      <p class="eyebrow">Tägliche Übung · etwa 45 Minuten</p>
      <h1>Wähle dein Kind</h1>
      <p class="lead">
        Deutsch, Englisch und Mathe für den Start in Deutschland.
      </p>
    </div>
  </section>

  <section class="choice-grid">
    <%= for {slug, child} <- @children do %>
      <button class="learner-card" phx-click="choose_child" phx-value-id={slug}>
        <span class="learner-name">{child.name}</span>
        <span>{child.age} Jahre alt</span>
        <strong>{child.target}</strong>
      </button>
    <% end %>
  </section>

  <section class="history">
    <%= if @cache_refresh do %>
      <div class="admin-note">{@cache_refresh}</div>
    <% end %>
    <%= if @result_sync do %>
      <div class="admin-note">{@result_sync}</div>
    <% end %>

    <h2>Letzte Ergebnisse</h2>
    <%= if @recent_results == [] do %>
      <p>Noch keine gespeicherte Übung.</p>
    <% else %>
      <div class="results-list">
        <%= for result <- @recent_results do %>
          <div class="result-row">
            <strong>{result.child_name}</strong>
            <span>{Learning.subject_label(result.subject)}</span>
            <span>{result.score}/{result.total}</span>
            <span>{percent(result.score, result.total)}%</span>
            <%= if @current_user["role"] == "admin" do %>
              <span class={["sync-state", result.notion_synced_at && "ok"]}>
                <%= if result.notion_synced_at do %>
                  Notion OK
                <% else %>
                  Notion offen
                <% end %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>

<%= if @mode == :dashboard and @dashboard do %>
  <section class="intro compact">
    <div>
      <p class="eyebrow">Admin · SQLite-Auswertung</p>
      <h1>Leistung</h1>
      <p class="lead">
        Fortschritt, aktuelle Lernstufe und Übungsschwerpunkte aus den gespeicherten Ergebnissen.
      </p>
    </div>
  </section>

  <section class="dashboard-grid">
    <%= for child <- @dashboard.children do %>
      <article class="dashboard-panel">
        <div class="panel-head">
          <div>
            <p class="eyebrow">{child.name}</p>
            <h2>{child.average}% Durchschnitt</h2>
          </div>
          <strong>{child.attempts} Übungen</strong>
        </div>

        <div class="subject-stats">
          <%= for stat <- child.subjects do %>
            <div class={"stat-row #{stat.subject}"}>
              <div class="stat-meta">
                <strong>{stat.label}</strong>
                <span>Stufe {stat.level} · {stat.attempts} Übungen · zuletzt {stat.latest}%</span>
              </div>
              <div class="bar">
                <span style={chart_width(stat.average)}></span>
              </div>
              <div class="sparkline" aria-label={"Trend #{stat.label}"}>
                <%= for value <- stat.trend do %>
                  <span style={"height: #{max(value, 8)}%"} title={"#{value}%"}></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </article>
    <% end %>
  </section>

  <section class="history">
    <h2>Schwerpunkte zum Wiederholen</h2>
    <%= if @dashboard.weak_skills == [] do %>
      <p>Noch keine Schwachstellen gespeichert.</p>
    <% else %>
      <div class="weak-list">
        <%= for item <- @dashboard.weak_skills do %>
          <div class="weak-row">
            <strong>{item.child}</strong>
            <span>{item.label}</span>
            <span>{item.skill}</span>
            <em>{item.count} Fehler</em>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>

<%= if @mode == :subject do %>
  <% child = Learning.child!(@child_slug) %>
  <section class="intro compact">
    <div>
      <p class="eyebrow">{child.name}</p>
      <h1>Wähle ein Fach</h1>
    </div>
  </section>

  <section class="subject-grid">
    <%= for subject <- @subjects do %>
      <% count = Learning.daily_question_count(@child_slug, subject) %>
      <button class={"subject-card #{subject}"} phx-click="choose_subject" phx-value-id={subject}>
        <span>{Learning.subject_label(subject)}</span>
        <strong>{count} Fragen · etwa 45 Minuten</strong>
      </button>
    <% end %>
  </section>
<% end %>

<%= if @mode in [:quiz, :retry] and length(@questions) > 0 do %>
  <% question = Enum.at(@questions, @index) %>
  <section class="quiz-head">
    <div>
      <p class="eyebrow">{Learning.subject_label(@subject)} · {question.skill}</p>
      <h1>Frage {@index + 1} von {length(@questions)}</h1>
    </div>
    <progress value={@index + 1} max={length(@questions)}></progress>
  </section>

  <section class="question-panel">
    <p class="prompt">{question.prompt}</p>
    <div class="answers">
      <%= for choice <- question.choices do %>
        <button
          class={[
            "answer",
            @selected == to_string(choice) && "selected",
            @feedback && to_string(choice) == to_string(question.answer) && "correct",
            @feedback && @selected == to_string(choice) &&
              to_string(choice) != to_string(question.answer) && "wrong"
          ]}
          disabled={not is_nil(@feedback)}
          phx-click="answer"
          phx-value-choice={choice}
        >
          {choice}
        </button>
      <% end %>
    </div>

    <%= if @feedback do %>
      <div class={["feedback", @feedback.correct? && "ok"]}>
        <strong>{@feedback.title}</strong>
        <p>{@feedback.body}</p>
        <button class="btn next" phx-click="next">Weiter</button>
      </div>
    <% end %>
  </section>
<% end %>

<%= if @mode == :done do %>
  <% total = length(@questions) %>
  <% score = Enum.count(@answers, & &1.correct?) %>
  <section class="done">
    <p class="eyebrow">Ergebnis gespeichert</p>
    <h1>{score}/{total} richtig</h1>
    <div class="score-ring">{percent(score, total)}%</div>
    <p class="lead">
      <%= if @wrong == [] do %>
        Super. In dieser Runde war keine Frage falsch.
      <% else %>
        Übe die falschen Fragen noch einmal wie auf einem Spielplatz.
      <% end %>
    </p>
    <div class="actions">
      <%= if @wrong != [] do %>
        <button class="btn" phx-click="retry_wrong">Falsche Fragen wiederholen</button>
      <% end %>
      <button class="btn ghost" phx-click="home">Zur Startseite</button>
    </div>
  </section>
<% end %>
