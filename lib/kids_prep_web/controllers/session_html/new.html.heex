<main class="login-shell">
  <section class="login-panel">
    <p class="eyebrow">Private Übung</p>
    <h1>Anmelden</h1>
    <p class="lead">Wähle dein eigenes Konto, bevor du mit der heutigen Übung beginnst.</p>

    <form class="login-form" action={~p"/login"} method="post">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <label>
        Benutzername <input name="user[username]" autocomplete="username" required autofocus />
      </label>
      <label>
        Passwort
        <input name="user[password]" type="password" autocomplete="current-password" required />
      </label>
      <button class="btn" type="submit">Anmelden</button>
    </form>
  </section>
</main>
